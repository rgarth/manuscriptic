{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manuscriptic",
  "version": "0.2.0",
  "identifier": "app.manuscriptic.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Manuscriptic",
        "width": 1100,
        "height": 760,
        "minWidth": 840,
        "minHeight": 560,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["manuscriptic"],
        "name": "Manuscriptic book",
        "rank": "Owner",
        "exportedType": {
          "identifier": "app.manuscriptic.book",
          "conformsTo": ["public.data"]
        }
      }
    ]
  }
}
